{% extends 'base.html' %}
{% load static %}

{% block content %}
<style>
:root{
  --pl-primary:var(--primary-color,#2f8f4e);
  --pl-primary-dark:var(--primary-dark,#246f3c);
  --pl-primary-soft:color-mix(in srgb,var(--pl-primary) 12%,transparent);
  --pl-card:var(--card-bg,#fff);
  --pl-bg:var(--body-bg,#f4f7f5);
  --pl-text:var(--text-color,#17201a);
  --pl-muted:var(--text-muted,#667085);
  --pl-border:var(--border-color,#e1e8e3);
  --pl-danger:#dc3545;
  --pl-info:#2563eb;
  --pl-success:#198754;
  --pl-warning:#d97706;
}
*{box-sizing:border-box}
.pl-page{max-width:1500px;margin:auto;padding:18px;color:var(--pl-text)}
.pl-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding:24px;margin-bottom:16px;border:1px solid var(--pl-border);border-radius:22px;background:radial-gradient(circle at 95% 10%,var(--pl-primary-soft),transparent 34%),var(--pl-card);box-shadow:0 12px 32px rgba(21,39,27,.08)}
.pl-kicker{margin-bottom:7px;color:var(--pl-primary);font-size:.77rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}
.pl-title{margin:0;font-size:clamp(1.5rem,3vw,2.2rem);font-weight:850}
.pl-sub{margin:8px 0 0;color:var(--pl-muted);line-height:1.5}
.pl-hero-actions,.pl-actions,.pl-expanded-actions{display:flex;gap:8px;flex-wrap:wrap}
.pl-hero-actions{justify-content:flex-end;min-width:min(100%,490px)}
.pl-search{display:flex;flex:1 1 290px;min-width:260px;border:1px solid var(--pl-border);border-radius:12px;overflow:hidden;background:var(--pl-card)}
.pl-search:focus-within{border-color:var(--pl-primary);box-shadow:0 0 0 4px var(--pl-primary-soft)}
.pl-search input{width:100%;min-width:0;padding:11px 13px;border:0;outline:0;background:transparent;color:var(--pl-text)}
.pl-search button{padding:0 15px;border:0;border-left:1px solid var(--pl-border);background:var(--pl-bg);cursor:pointer}
.pl-btn{min-height:42px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 13px;border:1px solid transparent;border-radius:11px;font-weight:750;cursor:pointer;white-space:nowrap;transition:.16s}
.pl-btn:hover{transform:translateY(-1px);filter:brightness(.98)}
.pl-btn:disabled{opacity:.62;cursor:wait;transform:none}
.pl-primary{background:var(--pl-primary);color:#fff}.pl-secondary{border-color:var(--pl-border);background:var(--pl-card);color:var(--pl-text)}
.pl-success{background:var(--pl-success);color:#fff}.pl-info{background:color-mix(in srgb,var(--pl-info) 12%,transparent);color:var(--pl-info)}
.pl-danger{background:color-mix(in srgb,var(--pl-danger) 11%,transparent);color:var(--pl-danger)}.pl-dark{background:#1f2937;color:#fff}
.pl-device-list{display:grid;gap:10px}.pl-device{overflow:hidden;border:1px solid var(--pl-border);border-radius:17px;background:var(--pl-card);box-shadow:0 4px 15px rgba(21,39,27,.05)}
.pl-device-head{display:grid;grid-template-columns:auto minmax(220px,1.35fr) minmax(160px,.65fr) minmax(220px,1fr);gap:14px;align-items:center;padding:13px 15px;cursor:pointer}.pl-device-head:hover{background:color-mix(in srgb,var(--pl-primary) 3%,transparent)}
.pl-toggle{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--pl-border);border-radius:12px;background:var(--pl-bg);color:var(--pl-primary);cursor:pointer}
.pl-toggle span{transition:.2s}.pl-device.open .pl-toggle span{transform:rotate(90deg)}
.pl-device-name{display:flex;align-items:center;gap:11px;min-width:0}.pl-avatar{width:46px;height:46px;display:grid;place-items:center;flex:0 0 auto;border:1px solid var(--pl-border);border-radius:14px;background:var(--pl-primary-soft);color:var(--pl-primary);font-weight:900;overflow:hidden}
.pl-avatar img{width:100%;height:100%;object-fit:cover;background:#fff}.pl-avatar img[hidden]{display:none}.pl-provider-name{margin-top:3px;color:var(--pl-muted);font-size:.8rem}
.pl-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pl-label{margin-bottom:4px;color:var(--pl-muted);font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.055em}.pl-muted{color:var(--pl-muted);font-size:.82rem;line-height:1.35}
.pl-device-body{display:none;padding:12px;border-top:1px solid var(--pl-border);background:var(--pl-bg)}.pl-device.open .pl-device-body{display:block}.pl-device-details{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;margin-bottom:10px;padding:12px;border:1px solid var(--pl-border);border-radius:13px;background:var(--pl-card)}.pl-device-facts{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr));gap:10px}.pl-device-fact{min-width:0;padding:8px 10px;border-radius:10px;background:var(--pl-bg)}.pl-device-tools{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.pl-device-tools .pl-btn{min-height:38px;padding:7px 10px;font-size:.78rem}
.pl-expanded-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:10px;padding:10px 11px;border:1px solid var(--pl-border);border-radius:12px;background:var(--pl-card)}
.pl-expanded-info{min-width:0}.pl-expanded-info strong{display:block;font-size:.86rem}.pl-expanded-info span{display:block;margin-top:2px;color:var(--pl-muted);font-size:.73rem}.pl-expanded-actions{justify-content:flex-end}
.pl-playlists{display:grid;gap:9px}.pl-playlist{display:grid;grid-template-columns:minmax(220px,1.35fr) minmax(130px,.5fr) minmax(150px,.65fr) auto;gap:14px;align-items:center;padding:11px 12px;border:1px solid var(--pl-border);border-radius:13px;background:var(--pl-card)}
.pl-tags{display:flex;gap:6px;flex-wrap:wrap}.pl-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:var(--pl-bg);color:var(--pl-muted);font-size:.71rem;font-weight:850}.status-ativo{background:#dcfce7;color:#166534}.status-erro{background:#fee2e2;color:#991b1b}.status-rascunho,.status-confirmacao_pendente{background:#fef3c7;color:#92400e}.status-nao_encontrada,.status-excluida{background:#e5e7eb;color:#374151}
.pl-id{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.78rem}.pl-empty{padding:28px 16px;border:1px dashed var(--pl-border);border-radius:14px;text-align:center;color:var(--pl-muted);background:var(--pl-card)}.pl-empty strong{display:block;margin-bottom:5px;color:var(--pl-text)}
.pl-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(13,24,17,.62);backdrop-filter:blur(5px);overflow:hidden}.pl-modal.show{display:flex}.pl-dialog{width:min(820px,100%);max-height:min(92vh,900px);display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--pl-border);border-radius:21px;background:var(--pl-card);box-shadow:0 28px 85px rgba(0,0,0,.24)}.pl-dialog.small,.pl-dialog-small{width:min(520px,100%)}.pl-dialog>form{display:flex;flex-direction:column;min-height:0;max-height:min(92vh,900px)}
.pl-modal-head{display:flex;justify-content:space-between;gap:15px;flex:0 0 auto;padding:18px 20px 14px;border-bottom:1px solid var(--pl-border)}.pl-modal-head h2{margin:0;font-size:1.15rem}.pl-modal-head p{margin:5px 0 0;color:var(--pl-muted);font-size:.82rem}.pl-close{width:38px;height:38px;flex:0 0 auto;border:1px solid var(--pl-border);border-radius:10px;background:var(--pl-bg);cursor:pointer}.pl-modal-body{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;padding:18px 20px;overscroll-behavior:contain}.pl-modal-foot{display:flex;justify-content:flex-end;gap:8px;flex:0 0 auto;padding:13px 20px;border-top:1px solid var(--pl-border);background:var(--pl-card);box-shadow:0 -8px 18px rgba(21,39,27,.05)}
.pl-section{margin-bottom:18px}.pl-section:last-child{margin-bottom:0}.pl-section-title{margin:0 0 11px;color:var(--pl-primary-dark);font-size:.86rem;font-weight:850}.pl-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pl-field.full{grid-column:1/-1}.pl-field label{display:block;margin-bottom:6px;font-size:.79rem;font-weight:800}.pl-hint{color:var(--pl-muted);font-size:.71rem;font-weight:500}.pl-control{width:100%;min-height:43px;padding:10px 11px;border:1px solid var(--pl-border);border-radius:10px;outline:0;background:var(--pl-card);color:var(--pl-text)}textarea.pl-control{min-height:82px;resize:vertical}.pl-control:focus{border-color:var(--pl-primary);box-shadow:0 0 0 4px var(--pl-primary-soft)}.pl-field-help,.pl-help{display:block;margin-top:6px;color:var(--pl-muted);font-size:.72rem;line-height:1.4}.pl-input-password{position:relative}.pl-input-password .pl-control{padding-right:46px}.pl-password-toggle{position:absolute;top:50%;right:7px;width:34px;height:34px;border:0;border-radius:8px;background:transparent;cursor:pointer;transform:translateY(-50%)}.pl-password-toggle:hover{background:rgba(15,23,42,.08)}
.pl-switch{display:flex!important;align-items:center;gap:10px;padding:11px 12px;border:1px solid var(--pl-border);border-radius:11px;background:var(--pl-bg)}.pl-switch input{width:18px;height:18px;accent-color:var(--pl-primary)}.pl-switch strong{display:block;font-size:.81rem}.pl-switch small{display:block;color:var(--pl-muted);font-weight:500}.pl-warning{padding:12px;border:1px solid #fed7aa;border-radius:11px;background:#fff7ed;color:#9a3412;font-size:.8rem;line-height:1.45}.pl-delete-warning{display:flex;align-items:flex-start;gap:14px;padding:16px;border:1px solid #fecaca;border-radius:12px;background:#fff7f7}.pl-delete-icon{font-size:25px}.pl-delete-warning p{margin:5px 0 0;color:var(--pl-muted)}.pl-confirm-check{display:flex;align-items:flex-start;gap:10px;margin-top:18px;cursor:pointer}.pl-confirm-check input{margin-top:3px}.hidden{display:none!important}
.pl-history{display:grid;gap:8px}.pl-history-item{padding:11px;border:1px solid var(--pl-border);border-radius:11px;background:var(--pl-bg)}.pl-history-head{display:flex;justify-content:space-between;gap:9px;margin-bottom:5px}.pl-history-item p{margin:0;color:var(--pl-muted);font-size:.8rem}.pl-time{color:var(--pl-muted);font-size:.71rem;white-space:nowrap}.pl-toasts{position:fixed;right:18px;top:18px;z-index:12000;width:min(390px,calc(100vw - 36px));display:grid;gap:8px}.pl-toast{display:grid;grid-template-columns:auto 1fr auto;gap:9px;padding:12px;border:1px solid var(--pl-border);border-radius:12px;background:var(--pl-card);box-shadow:0 18px 45px rgba(0,0,0,.16)}.pl-toast.success{border-left:4px solid var(--pl-success)}.pl-toast.error{border-left:4px solid var(--pl-danger)}.pl-toast button{border:0;background:transparent;cursor:pointer}.pl-spinner{width:15px;height:15px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin .6s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1100px){.pl-device-head{grid-template-columns:auto minmax(180px,1fr) minmax(130px,.6fr)}.pl-device-message{grid-column:2/-1}.pl-device-details{grid-template-columns:1fr}.pl-device-tools{justify-content:flex-start}.pl-playlist{grid-template-columns:minmax(190px,1fr) minmax(130px,.55fr) auto}.pl-id-block{grid-column:1/3}}
@media(max-width:760px){.pl-page{padding:8px}.pl-hero{align-items:stretch;flex-direction:column;padding:16px;border-radius:16px}.pl-title{font-size:1.45rem}.pl-sub{font-size:.86rem}.pl-hero-actions{min-width:0;justify-content:stretch}.pl-search{min-width:0;flex-basis:100%}.pl-hero-actions>.pl-btn{flex:1;min-height:40px}.pl-device-list{gap:8px}.pl-device{border-radius:14px}.pl-device-head{grid-template-columns:38px minmax(0,1fr);gap:9px;padding:10px}.pl-toggle{width:38px;height:38px;border-radius:10px}.pl-avatar{width:40px;height:40px;border-radius:11px}.pl-device-name{gap:9px}.pl-device-name strong{font-size:.9rem}.pl-provider-name{font-size:.72rem}.pl-device-meta,.pl-device-message{grid-column:2/-1}.pl-device-meta{display:none}.pl-device-message .pl-label{display:none}.pl-device-message .pl-muted{display:-webkit-box;overflow:hidden;-webkit-line-clamp:1;-webkit-box-orient:vertical;font-size:.73rem}.pl-device-body{padding:7px}.pl-device-details{grid-template-columns:1fr;gap:9px;margin-bottom:8px;padding:9px}.pl-device-facts{grid-template-columns:1fr 1fr;gap:7px}.pl-device-fact{padding:7px 8px}.pl-device-fact:last-child{grid-column:1/-1}.pl-device-tools{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;width:100%}.pl-device-tools .pl-btn{min-width:0;min-height:36px;padding:6px 7px;font-size:.72rem;border-radius:9px}.pl-expanded-toolbar{align-items:stretch;flex-direction:column;gap:8px;margin-bottom:8px;padding:9px}.pl-expanded-info span{display:none}.pl-expanded-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px}.pl-expanded-actions .pl-btn{min-height:38px;padding:7px 8px;font-size:.75rem}.pl-playlist{grid-template-columns:1fr;gap:7px;padding:9px;border-radius:11px}.pl-playlist>.pl-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;width:100%}.pl-playlist>.pl-actions .pl-btn{min-width:0;min-height:35px;padding:6px 5px;font-size:.7rem;border-radius:8px}.pl-id-block{grid-column:auto}.pl-tags{gap:4px}.pl-badge{padding:4px 6px;font-size:.65rem}.pl-modal{align-items:flex-end;padding:0;height:100dvh}.pl-dialog,.pl-dialog.small,.pl-dialog-small,.pl-dialog>form{width:100%;max-height:96dvh;border-radius:21px 21px 0 0}.pl-modal-head,.pl-modal-body{padding-left:15px;padding-right:15px}.pl-modal-foot{flex-wrap:wrap;padding:11px 15px max(11px,env(safe-area-inset-bottom))}.pl-modal-foot .pl-btn{flex:1 1 145px}.pl-grid{grid-template-columns:1fr}.pl-field.full{grid-column:auto}}
@media(max-width:430px){.pl-avatar{display:none}.pl-device-head{grid-template-columns:36px minmax(0,1fr)}.pl-device-facts{grid-template-columns:1fr}.pl-device-fact:last-child{grid-column:auto}.pl-device-tools{grid-template-columns:1fr 1fr}.pl-device-tools .pl-btn:last-child{grid-column:1/-1}.pl-playlist>.pl-actions{grid-template-columns:1fr 1fr}.pl-playlist>.pl-actions .pl-btn:last-child:nth-child(odd){grid-column:1/-1}.pl-modal-foot .pl-btn{flex-basis:100%}}

/* Substituição remota manual */
.pl-warning-pending{border-color:#fde68a;background:#fffbeb;color:#92400e}
.pl-btn-pending{border-color:#f59e0b;background:#fffbeb;color:#92400e}
.pl-btn-pending:hover{background:#fef3c7}
.pl-replace-summary{display:grid;gap:10px;padding:14px;border:1px solid var(--pl-border);border-radius:13px;background:var(--pl-bg)}
.pl-replace-summary strong{font-size:.9rem}.pl-replace-summary p{margin:0;color:var(--pl-muted);font-size:.8rem;line-height:1.45}
@media(max-width:760px){.pl-btn-pending{flex:1 1 100%}.pl-playlist .pl-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%}.pl-playlist .pl-actions .pl-btn{min-height:38px;padding:7px 9px;font-size:.76rem}.pl-playlist .pl-actions .pl-btn-pending{grid-column:1/-1}}


/* Tabela expansível de dispositivos */
.pl-device-table{display:block;border:1px solid var(--pl-border);border-radius:16px;background:var(--pl-card);overflow-y:auto;overflow-x:hidden}
.pl-table-head,.pl-device-head{display:grid;grid-template-columns:52px minmax(190px,1.25fr) minmax(130px,.75fr) minmax(170px,.85fr) 90px minmax(220px,1.2fr);align-items:center;gap:12px}
.pl-table-head{position:sticky;top:0;z-index:8;padding:11px 14px;border-bottom:1px solid var(--pl-border);background:var(--pl-bg);color:var(--pl-muted);font-size:.7rem;font-weight:850;text-transform:uppercase;letter-spacing:.055em}
.pl-device{border:0;border-bottom:1px solid var(--pl-border);border-radius:0;box-shadow:none;overflow:visible}
.pl-device:last-child{border-bottom:0}
.pl-device-head{padding:11px 14px;cursor:pointer;background:var(--pl-card)}
.pl-device-head:hover{background:color-mix(in srgb,var(--pl-primary) 4%,var(--pl-card))}
.pl-device.open>.pl-device-head{background:color-mix(in srgb,var(--pl-primary) 7%,var(--pl-card))}
.pl-device-body{border-top:1px solid var(--pl-border);padding:12px 14px 14px;background:var(--pl-bg)}
.pl-table-cell{min-width:0;font-size:.82rem}
.pl-count-badge{display:inline-flex;min-width:30px;height:27px;align-items:center;justify-content:center;padding:0 8px;border-radius:999px;background:var(--pl-soft);color:var(--pl-primary-dark);font-weight:850}
.pl-device-name .pl-avatar{width:36px;height:36px;border-radius:10px}
.pl-device-name strong{font-size:.86rem}
.pl-device-message .pl-muted{display:-webkit-box;overflow:hidden;-webkit-line-clamp:1;-webkit-box-orient:vertical}
.pl-device-head:focus-visible{outline:3px solid var(--pl-soft);outline-offset:-3px}

@media(max-width:1050px){
 .pl-table-head,.pl-device-head{grid-template-columns:48px minmax(180px,1.2fr) minmax(120px,.7fr) minmax(150px,.8fr) 76px}
 .pl-table-head>div:last-child,.pl-device-head>.pl-device-message{display:none}
}
@media(max-width:760px){
 .pl-device-table{border-radius:13px}
 .pl-table-head{display:none}
 .pl-device{border-bottom:1px solid var(--pl-border)}
 .pl-device-head{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:9px;padding:10px}
 .pl-device-head>.pl-device-name{grid-column:2}
 .pl-device-head>.pl-table-cell{display:none}
 .pl-device-head>.pl-table-cell[data-label="Playlists"]{display:flex;grid-column:3;align-items:center;justify-content:flex-end}
 .pl-device-name .pl-avatar{width:36px;height:36px}
 .pl-count-badge{min-width:27px;height:25px;font-size:.72rem}
 .pl-device-body{padding:8px}
}
</style>

<div class="pl-page">
  <header class="pl-hero">
    <div>
      <div class="pl-kicker">◉ Integrações de aplicativos</div>
      <h1 class="pl-title">Gerenciador de playlists</h1>
      <p class="pl-sub">Cadastre dispositivos, importe listas existentes e gerencie cada playlist individualmente.</p>
    </div>
    <div class="pl-hero-actions">
      <form class="pl-search" method="get">
        <input type="search" name="termo" value="{{ termo }}" placeholder="Nome, MAC, playlist ou ID remoto">
        <button type="submit" title="Pesquisar" aria-label="Pesquisar">⌕</button>
      </form>
      <button type="button" class="pl-btn pl-primary" data-new-device>＋ Novo dispositivo</button>
    </div>
  </header>

  <main class="pl-device-list pl-device-table">
    <div class="pl-table-head" aria-hidden="true">
      <div></div>
      <div>Dispositivo</div>
      <div>Aplicativo</div>
      <div>MAC Address</div>
      <div>Playlists</div>
      <div>Situação</div>
    </div>

    {% for integracao in integracoes %}
    <section class="pl-device" id="device-{{ integracao.id }}">
      <div class="pl-device-head" role="button" tabindex="0" aria-controls="device-body-{{ integracao.id }}">
        <button type="button" class="pl-toggle" data-toggle aria-expanded="false" aria-controls="device-body-{{ integracao.id }}"><span>▶</span></button>

        <div class="pl-device-name" data-label="Dispositivo">
          <div class="pl-avatar" data-provider-avatar="{{ integracao.provedor|escape }}">
            <img alt="" hidden>
            <span>{{ integracao.nome_exibicao|default:'D'|slice:':1'|upper }}</span>
          </div>
          <div class="pl-ellipsis"><strong class="pl-ellipsis">{{ integracao.nome_exibicao }}</strong></div>
        </div>

        <div class="pl-table-cell" data-label="Aplicativo">
          <span class="pl-provider-name">{{ integracao.provedor_nome_view|default:integracao.get_provedor_display }}</span>
        </div>

        <div class="pl-table-cell" data-label="MAC Address">
          <span class="pl-ellipsis" title="{{ integracao.mac_address|default:'' }}">{{ integracao.mac_address|default:'Não informado' }}</span>
        </div>

        <div class="pl-table-cell" data-label="Playlists">
          <span class="pl-count-badge">{{ integracao.playlists.count }}</span>
        </div>

        <div class="pl-device-message pl-table-cell" data-label="Situação">
          <div class="pl-muted">{{ integracao.ultima_mensagem|default:'Ainda não sincronizado.' }}</div>
        </div>
      </div>

      <div class="pl-device-body" id="device-body-{{ integracao.id }}">
        <div class="pl-device-details">
          <div class="pl-device-facts">
            <div class="pl-device-fact"><div class="pl-label">MAC Address</div><div class="pl-ellipsis" title="{{ integracao.mac_address|default:'' }}">{{ integracao.mac_address|default:'Não informado' }}</div></div>
            <div class="pl-device-fact"><div class="pl-label">Aplicativo</div><div class="pl-ellipsis">{{ integracao.provedor_nome_view|default:integracao.get_provedor_display }}</div></div>
            <div class="pl-device-fact"><div class="pl-label">Situação</div><div class="pl-muted">{{ integracao.ultima_mensagem|default:'Ainda não sincronizado.' }}</div></div>
          </div>
          <div class="pl-device-tools">
            <button type="button" class="pl-btn pl-secondary" data-edit-device data-id="{{ integracao.id }}" data-name="{{ integracao.nome_avulso|default:''|escape }}" data-client="{{ integracao.cliente_id|default:'' }}" data-provider="{{ integracao.provedor|escape }}" data-mac="{{ integracao.mac_address|default:''|escape }}" data-key="{{ integracao.device_key|default:''|escape }}">✎ Editar</button>
            <button type="button" class="pl-btn pl-dark" data-history="{% url 'historico_integracao_playlist' integracao.id %}">◷ Histórico</button>
