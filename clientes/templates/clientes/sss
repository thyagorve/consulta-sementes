<script>
/* Calcula o espaço real disponível abaixo do cabeçalho do sistema.
   Isso evita que o título entre na área de rolagem, independentemente
   da altura do menu/base.html. */
(function(){
    const page = document.querySelector('.pl-page');
    if (!page) return;

    function ajustarAreaPlaylist(){
        const viewportHeight = window.visualViewport
            ? window.visualViewport.height
            : window.innerHeight;

        const top = page.getBoundingClientRect().top;
        const margemInferior = window.innerWidth <= 760 ? 6 : 14;
        const alturaDisponivel = Math.max(320, viewportHeight - top - margemInferior);

        page.style.height = `${alturaDisponivel}px`;
    }

    ajustarAreaPlaylist();
    window.addEventListener('resize', ajustarAreaPlaylist, {passive:true});
    window.addEventListener('orientationchange', ajustarAreaPlaylist, {passive:true});

    if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', ajustarAreaPlaylist, {passive:true});
    }

    requestAnimationFrame(ajustarAreaPlaylist);
    setTimeout(ajustarAreaPlaylist, 150);
})();
</script>
