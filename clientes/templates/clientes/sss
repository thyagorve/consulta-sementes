<script>
(()=>{'use strict';
const $=(s,c=document)=>c.querySelector(s), $$=(s,c=document)=>[...c.querySelectorAll(s)];
let providers=[];try{providers=JSON.parse($('#playlist-providers-data')?.textContent||'[]')}catch(e){console.warn('JSON de providers inválido',e)}
const csrf=()=>$('[name="csrfmiddlewaretoken"]')?.value||'';
const esc=v=>{const d=document.createElement('div');d.textContent=String(v??'');return d.innerHTML};
function toast(msg,type='info'){const box=$('#plToasts');if(!box)return;const el=document.createElement('div');el.className=`pl-toast ${type}`;el.innerHTML=`<b>${type==='success'?'✓':type==='error'?'!':'i'}</b><div>${esc(msg||'Operação concluída.')}</div><button type="button">✕</button>`;el.querySelector('button').onclick=()=>el.remove();box.appendChild(el);setTimeout(()=>el.remove(),5000)}
function loading(btn,on,text='Processando...'){if(!btn)return;if(on){btn.dataset.html=btn.innerHTML;btn.disabled=true;btn.innerHTML=`<span class="pl-spinner"></span>${esc(text)}`}else{btn.disabled=false;btn.innerHTML=btn.dataset.html||btn.innerHTML}}
async function request(url,opt={}){const response=await fetch(url,{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest',...(opt.headers||{})},...opt});let data;try{data=await response.json()}catch{data={success:false,message:`Resposta inválida do servidor (${response.status}).`}}if(!response.ok&&data.success!==true)throw new Error(data.message||`Erro HTTP ${response.status}`);return data}
function openModal(modal){if(!modal)return;modal.classList.add('show');document.body.style.overflow='hidden';setTimeout(()=>modal.querySelector('input:not([type=hidden]),select,textarea,button')?.focus(),40)}
function closeModal(modal){if(!modal)return;modal.classList.remove('show');if(!$('.pl-modal.show'))document.body.style.overflow=''}
$$('[data-close]').forEach(btn=>btn.addEventListener('click',()=>closeModal(btn.closest('.pl-modal'))));
$$('.pl-modal').forEach(modal=>modal.addEventListener('mousedown',e=>{if(e.target===modal)closeModal(modal)}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal($('.pl-modal.show'))});

function providerBySlug(slug){return providers.find(item=>String(item.slug||item.valor||'')===String(slug||''))||{}}
function providerLogo(provider){return provider.logo_url||provider.imagem_url||provider.icone_url||provider.logo||''}
$$('[data-provider-avatar]').forEach(avatar=>{const provider=providerBySlug(avatar.dataset.providerAvatar);const url=providerLogo(provider);const img=avatar.querySelector('img'),fallback=avatar.querySelector('span');if(url&&img){img.src=url;img.alt=provider.nome||'Aplicativo';img.onload=()=>{img.hidden=false;if(fallback)fallback.hidden=true};img.onerror=()=>{img.hidden=true;if(fallback)fallback.hidden=false}}});

function toggleDevice(card){if(!card)return;const btn=card.querySelector('[data-toggle]');const open=card.classList.toggle('open');btn?.setAttribute('aria-expanded',String(open))}$$('[data-toggle]').forEach(btn=>btn.addEventListener('click',e=>{e.stopPropagation();toggleDevice(btn.closest('.pl-device'))}));$$('.pl-device-head').forEach(head=>{head.addEventListener('click',()=>toggleDevice(head.closest('.pl-device')));head.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleDevice(head.closest('.pl-device'))}})});
$$('[data-post]').forEach(btn=>btn.addEventListener('click',async()=>{loading(btn,true,btn.dataset.loading||'Processando...');try{const body=new URLSearchParams({csrfmiddlewaretoken:csrf()});const data=await request(btn.dataset.post,{method:'POST',body});toast(data.message,data.success?'success':'error');if(data.success&&btn.dataset.reload)setTimeout(()=>location.reload(),450)}catch(e){toast(e.message,'error')}finally{loading(btn,false)}}));

const pullModal=$('#pullListsModal'),pullForm=$('#pullListsForm');
$$('[data-pull-lists]').forEach(btn=>btn.addEventListener('click',()=>{pullForm.reset();const usaPin=(btn.dataset.provider||'')==='fun_plays';const pinField=$('#pullListsPin')?.closest('.pl-field');$('#pullListsUrl').value=btn.dataset.url||'';pinField?.classList.toggle('hidden',!usaPin);if($('#pullListsPin'))$('#pullListsPin').disabled=!usaPin;$('#pullListsDevice').textContent=usaPin?`Dispositivo: ${btn.dataset.deviceName||'Dispositivo'}. Informe o PIN apenas para liberar playlists protegidas.`:`Dispositivo: ${btn.dataset.deviceName||'Dispositivo'}. Este aplicativo não exige PIN para puxar as playlists.`;openModal(pullModal)}));
pullForm?.addEventListener('submit',async e=>{e.preventDefault();const btn=e.submitter,url=$('#pullListsUrl').value;if(!url)return toast('Rota para puxar listas não encontrada.','error');loading(btn,true,'Puxando...');try{const data=await request(url,{method:'POST',body:new FormData(pullForm)});toast(data.message,data.success?'success':'error');if(data.success){closeModal(pullModal);setTimeout(()=>location.reload(),450)}}catch(err){toast(err.message,'error')}finally{loading(btn,false)}});

const dModal=$('#deviceModal'),dForm=$('#deviceForm'),dProvider=$('#deviceProvider');
function providerFields(){if(!dProvider)return;const slug=dProvider.value,provider=providerBySlug(slug),config=provider.campos||{};$$('[data-device-field]').forEach(wrapper=>{const name=wrapper.dataset.deviceField,field=config[name]||{},input=wrapper.querySelector(`[name="${name}"]`),label=wrapper.querySelector('[data-label]');if(!input)return;let show=field.mostrar!==false,required=Boolean(field.obrigatorio);if(slug==='fun_plays'&&['mac_address','device_key'].includes(name)){show=true;required=true}wrapper.classList.toggle('hidden',!show);input.disabled=!show;input.required=show&&required;if(field.label&&label)label.textContent=field.label;if(field.placeholder)input.placeholder=field.placeholder});const help=$('#deviceKeyHelp');if(help)help.textContent=slug==='fun_plays'?'Obrigatória para autenticar, puxar e administrar playlists do Fun Plays.':'Informe a Key somente quando o aplicativo solicitar.'}
function resetDevice(){dForm.reset();$('#deviceId').value='';$('#deviceTitle').textContent='Novo dispositivo';providerFields()}
dProvider?.addEventListener('change',providerFields);
$('[data-new-device]')?.addEventListener('click',()=>{resetDevice();openModal(dModal)});
$$('[data-edit-device]').forEach(btn=>btn.addEventListener('click',()=>{resetDevice();$('#deviceId').value=btn.dataset.id||'';$('#deviceName').value=btn.dataset.name||'';$('#deviceClient').value=btn.dataset.client||'';dProvider.value=btn.dataset.provider||'';$('#deviceMac').value=btn.dataset.mac||'';$('#deviceKey').value=btn.dataset.key||'';$('#deviceTitle').textContent='Editar dispositivo';providerFields();openModal(dModal)}));
$('#deviceClient')?.addEventListener('change',e=>{const option=e.target.selectedOptions[0];if(option?.value&&!$('#deviceName').value.trim())$('#deviceName').value=option.textContent.trim()});
dForm?.addEventListener('submit',async e=>{e.preventDefault();const btn=e.submitter;loading(btn,true,'Salvando...');try{const data=await request(dForm.action,{method:'POST',body:new FormData(dForm)});toast(data.message,data.success?'success':'error');if(data.success){closeModal(dModal);setTimeout(()=>location.reload(),450)}}catch(err){toast(err.message,'error')}finally{loading(btn,false)}});
$$('[data-toggle-password]').forEach(btn=>btn.addEventListener('click',()=>{const input=$(btn.dataset.togglePassword);if(!input)return;const show=input.type==='password';input.type=show?'text':'password';btn.textContent=show?'🙈':'👁'}));

const pModal=$('#playlistModal'),pForm=$('#playlistForm');
function mode(){const code=$('#playlistMode')?.value==='codigo';$('#playlistCodeField')?.classList.toggle('hidden',!code);$('#playlistDnsField')?.classList.toggle('hidden',code);$('#playlistUrlField')?.classList.toggle('hidden',code)}
function protect(){$('#playlistPinField')?.classList.toggle('hidden',!$('#playlistProtected')?.checked)}
$('#playlistMode')?.addEventListener('change',mode);$('#playlistProtected')?.addEventListener('change',protect);
function resetPlaylist(){pForm.reset();$('#playlistIntegration').value='';$('#playlistCreateUrl').value='';$('#playlistId').value='';$('#playlistEditUrl').value='';$('#playlistTitle').textContent='Nova playlist';$('#playlistSubtitle').textContent='Salve como rascunho ou envie ao aplicativo.';$('#saveUpload').classList.remove('hidden');mode();protect()}
$$('[data-new-playlist]').forEach(btn=>btn.addEventListener('click',()=>{resetPlaylist();$('#playlistIntegration').value=btn.dataset.newPlaylist||'';$('#playlistCreateUrl').value=btn.dataset.createUrl||'';openModal(pModal)}));
$$('[data-edit-playlist]').forEach(btn=>btn.addEventListener('click',()=>{resetPlaylist();$('#playlistId').value=btn.dataset.id||'';$('#playlistEditUrl').value=btn.dataset.editUrl||'';$('#playlistName').value=btn.dataset.name||'';$('#playlistClient').value=btn.dataset.client||'';$('#playlistUser').value=btn.dataset.user||'';$('#playlistPassword').value=btn.dataset.password||'';$('#playlistDns').value=btn.dataset.dns||'';$('#playlistCode').value=btn.dataset.code||'';$('#playlistUrl').value=btn.dataset.url||'';$('#playlistMode').value=btn.dataset.mode||'url';$('#playlistProtected').checked=btn.dataset.protected==='true';$('#playlistPin').value=btn.dataset.pin||'';$('#playlistTitle').textContent='Editar playlist';const remoteId=btn.dataset.remoteId||'';$('#playlistSubtitle').textContent=remoteId?`ID remoto: ${remoteId}`:'Playlist ainda não enviada ao painel.';$('#saveUpload').classList.add('hidden');mode();protect();openModal(pModal)}));
$('#playlistClient')?.addEventListener('change',e=>{const option=e.target.selectedOptions[0];if(option?.value){$('#playlistUser').value=option.dataset.user||'';$('#playlistPassword').value=option.dataset.password||''}});
