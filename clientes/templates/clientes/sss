              <button type="button" class="pl-btn pl-secondary" data-edit-playlist data-id="{{ playlist.id }}" data-client="{{ playlist.cliente_id|default:'' }}" data-name="{{ playlist.nome|default:''|escape }}" data-user="{{ playlist.usuario_iptv|default:''|escape }}" data-password="{{ playlist.senha_iptv|default:''|escape }}" data-dns="{{ playlist.dns|default:''|escape }}" data-code="{{ playlist.codigo|default:''|escape }}" data-url="{{ playlist.url_playlist|default:''|escape }}" data-mode="{{ playlist.modo_envio|default:'url' }}" data-protected="{{ playlist.protegida|yesno:'true,false' }}" data-pin="{{ playlist.pin_protecao|default:''|escape }}" data-remote-id="{{ playlist.remote_id|default:''|escape }}" data-edit-url="{% url 'editar_playlist' playlist.id %}">✎ Editar</button>
